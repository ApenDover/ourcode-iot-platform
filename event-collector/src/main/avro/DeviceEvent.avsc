{
  "type": "record",
  "name": "DeviceEvent",
  "namespace": "com.nashkod.avro",
  "fields": [
    {
      "name": "eventId",
      "type": "string"
    },
    {
      "name": "timestamp",
      "type": "long"
    },
    {
      "name": "type",
      "type": {
        "type": "enum",
        "name": "EventType",
        "symbols": [
          "TEMPERATURE",
          "HUMIDITY",
          "STATUS",
          "ERROR"
        ]
      }
    },
    {
      "name": "payload",
      "type": "string"
    },
    {
      "name": "device",
      "type": {
        "type": "record",
        "name": "Device",
        "namespace": "com.nashkod.avro",
        "fields": [
          {
            "name": "deviceId",
            "type": "string"
          },
          {
            "name": "deviceType",
            "type": "string"
          },
          {
            "name": "createdAt",
            "type": "long",
            "logicalType": "timestamp-millis"
          },
          {
            "name": "meta",
            "type": "string"
          }
        ]
      }
    }
  ]
}
