<FindBugsFilter>
    <Match>
        <Class name="~com\.nashkod\.avro\..*" />
        <Or>
            <Bug pattern="EI_EXPOSE_REP"/>   <!-- Для getSpecificData() -->
            <Bug pattern="EI_EXPOSE_REP2"/>  <!-- Для конструкторов -->
            <Bug pattern="MS_EXPOSE_REP"/>   <!-- Для getDecoder() -->
            <Bug pattern="RI_REDUNDANT_INTERFACES"/> <!-- Для избыточных интерфейсов -->
        </Or>
    </Match>

    <Match>
        <Class name="~.*\.service\.impl\..*ProducerImpl"/>
        <Bug pattern="EI_EXPOSE_REP2"/> <!-- Для KafkaTemplate в конструкторах -->
    </Match>

    <Match>
        <Class name="~.*Test.*"/>
        <Or>
            <Bug pattern="BC_UNCONFIRMED_CAST_OF_RETURN_VALUE"/>
            <Bug pattern="RV_RETURN_VALUE_IGNORED"/>
        </Or>
    </Match>
</FindBugsFilter>
