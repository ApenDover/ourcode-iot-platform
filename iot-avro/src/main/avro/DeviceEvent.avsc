{
  "type": "record",
  "name": "DeviceEvent",
  "namespace": "com.nashkod.avro",
  "fields": [
    {
      "name": "eventId",
      "type": "string"
    },
    {
      "name": "timestamp",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      }
    },
    {
      "name": "type",
      "type": {
        "type": "enum",
        "name": "EventType",
        "symbols": [
          "TEMPERATURE",
          "HUMIDITY",
          "STATUS",
          "TECH",
          "ERROR"
        ]
      }
    },
    {
      "name": "payload",
      "type": "string"
    },
    {
      "name": "device",
      "type": "com.nashkod.avro.Device"
    }
  ]
}
