# =========================
# PostgreSQL
# =========================
APP_DATASOURCE_1_URL=jdbc:postgresql://postgres1:5432/iot_platform
APP_DATASOURCE_1_USERNAME=myuser
APP_DATASOURCE_1_PASSWORD=strongpassword
APP_DATASOURCE_2_URL=jdbc:postgresql://postgres2:5432/iot_platform
APP_DATASOURCE_2_USERNAME=myuser
APP_DATASOURCE_2_PASSWORD=strongpassword
APP_REPLICA_DATASOURCE_1_URL=jdbc:postgresql://postgres1r:5432/iot_platform
APP_REPLICA_DATASOURCE_1_USERNAME=myuser
APP_REPLICA_DATASOURCE_1_PASSWORD=strongpassword
APP_REPLICA_DATASOURCE_2_URL=jdbc:postgresql://postgres2r:5432/iot_platform
APP_REPLICA_DATASOURCE_2_USERNAME=myuser
APP_REPLICA_DATASOURCE_2_PASSWORD=strongpassword

# =========================
# Cassandra
# =========================
CASSANDRA_CONTACT_POINTS=cassandra
CASSANDRA_PORT=9042
CASSANDRA_LOCAL_DATACENTER=datacenter1
CASSANDRA_KEYSPACE=iot_service
CASSANDRA_SCHEMA_ACTION=CREATE_IF_NOT_EXISTS
CASSANDRA_REPLICATION_STRATEGY="'class':'SimpleStrategy','replication_factor':'1'"

# =========================
# Redis
# =========================
REDIS_PASSWORD=redis_pass

# =========================
# MinIO
# =========================
MINIO_ROOT_USER=minio_admin
MINIO_ROOT_PASSWORD=minio_pass

# =========================
# Keycloak
# =========================
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# =========================
# Grafana
# =========================
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

# =========================
# COMMON
# =========================
SPRING_KAFKA_BOOTSTRAP_SERVERS=kafka:29092

SPRING_KAFKA_TEMPLATE_DEVICE_TOPIC=device
SPRING_KAFKA_TEMPLATE_DLT_DEVICE_TOPIC=device.DLT

SPRING_KAFKA_PRODUCER_KEY_SERIALIZER=org.apache.kafka.common.serialization.StringSerializer
SPRING_KAFKA_PRODUCER_VALUE_SERIALIZER=io.confluent.kafka.serializers.KafkaAvroSerializer

#-----------------PERFOMANCE-----------------------#
SPRING_KAFKA_PRODUCER_BATCH_SIZE=16384
SPRING_KAFKA_CONSUMER_MAX_POLL_RECORDS=50000
SPRING_KAFKA_CONSUMER_FETCH_MAX_WAIT=500
SPRING_KAFKA_CONSUMER_FETCH_MIN_SIZE=1024
SPRING_KAFKA_LISTENER_CONCURRENCY=3
SPRING_KAFKA_LISTENER_IDLE_BETWEEN_POLLS=1000
#-----------------PERFOMANCE-----------------------#

SPRING_KAFKA_PRODUCER_COMPRESSION_TYPE=snappy
SPRING_KAFKA_PRODUCER_PROPERTIES_SCHEMA_REGISTRY_URL=http://schema-registry:8081
SPRING_KAFKA_PRODUCER_PROPERTIES_AUTO_REGISTER_SCHEMAS=true
SPRING_KAFKA_CONSUMER_ENABLE_AUTO_COMMIT=false
SPRING_KAFKA_CONSUMER_GROUP_ID=device-group
SPRING_KAFKA_CONSUMER_AUTO_OFFSET_RESET=earliest
SPRING_KAFKA_CONSUMER_KEY_DESERIALIZER=org.apache.kafka.common.serialization.StringDeserializer
SPRING_KAFKA_CONSUMER_VALUE_DESERIALIZER=io.confluent.kafka.serializers.KafkaAvroDeserializer
SPRING_KAFKA_CONSUMER_PROPERTIES_SCHEMA_REGISTRY_URL=http://schema-registry:8081
SPRING_KAFKA_CONSUMER_PROPERTIES_SPECIFIC_AVRO_READER=true
SPRING_KAFKA_LISTENER_ACK_MODE=batch
SPRING_KAFKA_LISTENER_TYPE=batch
SPRING_KAFKA_CONSUMER_PROPERTIES_AVRO_REMOVE_JAVA_PROPERTIES=true
SPRING_KAFKA_TEMPLATE_OBSERVATION_ENABLED=true
SPRING_KAFKA_LISTENER_OBSERVATION_ENABLED=true

# =========================
# Device-Collector
# =========================
KAFKA_PRODUCER_SERVER_PORT=8887

# =========================
# Event-Collector
# =========================
EVENT_COLLECTOR_SERVER_PORT=8888
EVENT_COLLECTOR_MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
EVENT_COLLECTOR_MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=*
EVENT_COLLECTOR_MANAGEMENT_METRICS_TAGS_APPLICATION=event-collector
EVENT_COLLECTOR_MANAGEMENT_PROMETHEUS_METRICS_EXPORT_ENABLED=true
EVENT_COLLECTOR_MANAGEMENT_TRACING_ENABLED=true
EVENT_COLLECTOR_MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
EVENT_COLLECTOR_MANAGEMENT_TRACING_OTLP_ENDPOINT=http://alloy:4318
EVENT_COLLECTOR_MANAGEMENT_TRACING_OTLP_PROTOCOL=http/protobuf

EVENT_COLLECTOR_OPENTELEMETRY_INSTRUMENTATION_LOGBACK_MDC_ENABLED=true
EVENT_COLLECTOR_OPENTELEMETRY_SERVICE_NAME=event-collector
EVENT_COLLECTOR_OPENTELEMETRY_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
EVENT_COLLECTOR_OPENTELEMETRY_EXPORTER_OTLP_PROTOCOL=http/protobuf
EVENT_COLLECTOR_OPENTELEMETRY_EXPORTER_OTLP_TIMEOUT=10000
EVENT_COLLECTOR_OPENTELEMETRY_EXPORTER_OTLP_COMPRESSION=gzip
EVENT_COLLECTOR_OPENTELEMETRY_TRACES_EXPORTER=otlp
EVENT_COLLECTOR_OPENTELEMETRY_METRICS_EXPORTER=none
EVENT_COLLECTOR_OPENTELEMETRY_LOGS_EXPORTER=none
EVENT_COLLECTOR_OPENTELEMETRY_RESOURCE_ATTRIBUTES_SERVICE_VERSION=1.0.0
EVENT_COLLECTOR_OPENTELEMETRY_RESOURCE_ATTRIBUTES_DEPLOYMENT_ENVIRONMENT=docker

SPRING_KAFKA_TEMPLATE_EVENTS_TOPIC=events
SPRING_KAFKA_TEMPLATE_DLT_EVENTS_TOPIC=events.DLT

#-----------------PERFOMANCE-----------------------#
CASSANDRA_BATCH_SIZE=100
CASSANDRA_CONCURRENCY_SIZE=5
#-----------------PERFOMANCE-----------------------#

CASSANDRA_ERROR_MAX_ATTEMPTS=3
CASSANDRA_ERROR_MAX_BACKOFF=100
CASSANDRA_ERROR_JITTER_FACTOR=0.5
CACHE_EXPIRATION_SECONDS=30

# =========================
# Device-Collector
# =========================
DEVICE_COLLECTOR_SERVER_PORT=8889
DEVICE_COLLECTOR_MANAGEMENT_ENDPOINT_HEALTH_PROBES_ENABLED=true
DEVICE_COLLECTOR_MANAGEMENT_ENDPOINTS_WEB_EXPOSURE_INCLUDE=*
DEVICE_COLLECTOR_MANAGEMENT_METRICS_TAGS_APPLICATION=device-collector
DEVICE_COLLECTOR_MANAGEMENT_PROMETHEUS_METRICS_EXPORT_ENABLED=true
DEVICE_COLLECTOR_MANAGEMENT_TRACING_ENABLED=true
DEVICE_COLLECTOR_MANAGEMENT_TRACING_SAMPLING_PROBABILITY=1.0
DEVICE_COLLECTOR_MANAGEMENT_TRACING_OTLP_ENDPOINT=http://alloy:4318
DEVICE_COLLECTOR_MANAGEMENT_TRACING_OTLP_PROTOCOL=http/protobuf

DEVICE_COLLECTOR_OPENTELEMETRY_INSTRUMENTATION_LOGBACK_MDC_ENABLED=true
DEVICE_COLLECTOR_OPENTELEMETRY_SERVICE_NAME=device-collector
DEVICE_COLLECTOR_OPENTELEMETRY_EXPORTER_OTLP_ENDPOINT=http://alloy:4318
DEVICE_COLLECTOR_OPENTELEMETRY_EXPORTER_OTLP_PROTOCOL=http/protobuf
DEVICE_COLLECTOR_OPENTELEMETRY_EXPORTER_OTLP_TIMEOUT=10000
DEVICE_COLLECTOR_OPENTELEMETRY_EXPORTER_OTLP_COMPRESSION=gzip
DEVICE_COLLECTOR_OPENTELEMETRY_TRACES_EXPORTER=otlp
DEVICE_COLLECTOR_OPENTELEMETRY_METRICS_EXPORTER=none
DEVICE_COLLECTOR_OPENTELEMETRY_LOGS_EXPORTER=none
DEVICE_COLLECTOR_OPENTELEMETRY_RESOURCE_ATTRIBUTES_SERVICE_VERSION=1.0.0
DEVICE_COLLECTOR_OPENTELEMETRY_RESOURCE_ATTRIBUTES_DEPLOYMENT_ENVIRONMENT=docker
DEVICE_COLLECTOR_OPENTELEMETRY_RESOURCE_ATTRIBUTES_SERVICE_NAME=device-collector

SPRING_FLYWAY_ENABLED=false
SPRING_DATASOURCE_DRIVER_CLASS_NAME=org.apache.shardingsphere.driver.ShardingSphereDriver
SPRING_JPA_HIBERNATE_DDL_AUTO=none
SPRING_SQL_INIT_MODE=always

APP_SHARDINGSPHERE_LOGIC_TABLE=t_device
APP_SHARDINGSPHERE_SHARDING_COLUMN=device_id
APP_SHARDINGSPHERE_SHARD_COUNT=2
APP_SHARDINGSPHERE_ALGORITHM_EXPRESSION='shard$->{Math.abs(device_id.hashCode()) %% %s}'

APP_POSTGRES_RETRY_MAX_ATTEMPTS=3
APP_POSTGRES_RETRY_INITIAL_DELAY=1000
APP_POSTGRES_RETRY_MULTIPLIER=5

#-----------------PERFOMANCE-----------------------#

APP_POSTGRES_BATCH_SIZE=300

#-----------------PERFOMANCE-----------------------#
