	"item": [
		{
			"name": "addDeviceEvent",
			"event": [
				{
					"listen": "prerequest",
					"script": {
						"exec": [
							"function generateUlid() {",
							"    const ENCODING = \"0123456789ABCDEFGHJKMNPQRSTVWXYZ\"; // Crockford Base32",
							"    const time = Date.now();",
							"    let ulid = \"\";",
							"",
							"    // Первые 10 символов = время",
							"    let modTime = time;",
							"    let timeChars = [];",
							"    for (let i = 0; i < 10; i++) {",
							"        timeChars.push(ENCODING[modTime % 32]);",
							"        modTime = Math.floor(modTime / 32);",
							"    }",
							"    ulid += timeChars.reverse().join(\"\");",
							"",
							"    // Остальные 16 символов = случайные",
							"    for (let i = 0; i < 16; i++) {",
							"        ulid += ENCODING[Math.floor(Math.random() * 32)];",
							"    }",
							"",
							"    return ulid;",
							"}",
							"",
							"pm.environment.set(\"ulid\", generateUlid());",
							"pm.environment.set(\"random\", _.random(1, 20))",
							"pm.environment.set(\"temp\", _.random(-30, 35))"
						],
						"type": "text/javascript",
						"packages": {}
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [],
				"body": {
					"mode": "raw",
					"raw": "[{\n  \"eventId\": \"{{$guid}}\",\n  \"timestamp\": {{$timestamp}},\n  \"type\": \"TEMPERATURE\",\n  \"payload\": \"{{temp}}\",\n  \"device\": {\n    \"deviceId\": \"{{ulid}}\",\n    \"deviceType\": \"SENSOR\",\n    \"meta\": \"тут текст или json тогда и поле jsonb\",\n    \"createdAt\": 1692700000000\n  }\n}]",
					"options": {
						"raw": {
							"language": "json"
						}
					}
				},
