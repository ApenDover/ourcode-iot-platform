import java.util.concurrent.ConcurrentHashMap
import java.util.concurrent.ConcurrentLinkedQueue

props.keySet()
     .findAll { it == &quot;router_commands&quot; || it == &quot;router_counter&quot; }
     .each { key -&gt;
         if (key == &quot;router_commands&quot;) {
             def routerCommands = props[key] as ConcurrentHashMap
             if (routerCommands) {
                 log.info(&quot;${key}:&quot;)
                 routerCommands.each { routerUuid, queue -&gt;
                     def commandCount = (queue instanceof ConcurrentLinkedQueue) ? queue.size() : &quot;N/A&quot;
                     if (commandCount &gt; 0) {
                     log.info(&quot;  Router ${routerUuid}: ${commandCount} commands&quot;)
                     }
                 }
             } else {
                 log.info(&quot;${key} = empty&quot;)
             }
         } else {
             log.info(&quot;${key} = ${props[key]}&quot;)
         }
     }

// Дополнительная статистика
def routerCommands = props.get(&quot;router_commands&quot;) as ConcurrentHashMap
if (routerCommands) {
    def totalCommands = routerCommands.values().sum { queue -&gt;
        (queue instanceof ConcurrentLinkedQueue) ? queue.size() : 0
    }
    log.info(&quot;Total routers: ${routerCommands.size()}&quot;)
    log.info(&quot;Total commands pending ack: ${totalCommands}&quot;)
} else {
    log.info(&quot;No routers or commands in memory&quot;)
}</stringProp>
