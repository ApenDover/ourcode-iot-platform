          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="PollCommands PreProcessor" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.util.concurrent.ConcurrentHashMap
import java.util.concurrent.ConcurrentLinkedQueue

def routerCommands = props.get(&quot;router_commands&quot;)
if (routerCommands == null) {
    routerCommands = new java.util.concurrent.ConcurrentHashMap()
    props.put(&quot;router_commands&quot;, routerCommands)
}

String selectedRouterUuid = null

if (!routerCommands.isEmpty()) {
    def routerUuids = routerCommands.keySet().toArray()
    selectedRouterUuid = routerUuids[(Math.random() * routerUuids.size()) as int] as String
} else {
    selectedRouterUuid = UUID.randomUUID().toString()
    routerCommands[selectedRouterUuid] = new java.util.concurrent.ConcurrentLinkedQueue()
}

vars.put(&quot;random_router_serial&quot;, selectedRouterUuid)</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="PollCommands PostProcessor" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import java.util.concurrent.ConcurrentHashMap
import java.util.concurrent.ConcurrentLinkedQueue

if (prev == null) {
    log.warn(&quot;PollCommands PostProcessor: prev is null, skipping&quot;)
    return
}

def response = prev.getResponseDataAsString()
if (!response?.trim()?.startsWith(&apos;{&apos;)) {
    log.warn(&quot;PollCommands: пустой или некорректный ответ&quot;)
    return
}

try {
    def routerCommands = props.get(&quot;router_commands&quot;)
    if (routerCommands == null) {
        log.warn(&quot;PollCommands: router_commands is null&quot;)
        return
    }
    
    def json = new JsonSlurper().parseText(response)
    def requestedRouter = vars.get(&quot;random_router_serial&quot;)
    
    if (!routerCommands.containsKey(requestedRouter)) {
        routerCommands[requestedRouter] = new java.util.concurrent.ConcurrentLinkedQueue()
    }
    
    def queue = routerCommands[requestedRouter]
    
    if (json.commands) {
        json.commands.each { cmd -&gt;
            if (cmd?.id) {
                def commandId = cmd.id as String
                if (!queue.contains(commandId)) {
                    queue.add(commandId)
                    log.info(&quot;PollCommands: добавлена команда ${commandId} для роутера ${requestedRouter}&quot;)
                }
            }
        }
    }
    if (queue.size() &gt; 0) {
    log.info(&quot;PollCommands: для роутера ${requestedRouter} теперь ${queue.size()} команд для ack&quot;)
    }
    
} catch (Exception e) {
    log.error(&quot;PollCommands: ошибка обработки ответа: ${e.message}&quot;)
}</stringProp>
          </JSR223PostProcessor>
