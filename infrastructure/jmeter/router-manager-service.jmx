        <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor">
          <stringProp name="scriptLanguage">groovy</stringProp>
          <stringProp name="parameters"></stringProp>
          <stringProp name="filename"></stringProp>
          <stringProp name="cacheKey">true</stringProp>
          <stringProp name="script">synchronized(props) {
    def pairs = props.get(&quot;poll_pairs&quot;)
    if (!(pairs instanceof List)) {
        pairs = []
        props.put(&quot;poll_pairs&quot;, pairs)
    }

    // Фильтруем null или некорректные пары
    pairs = pairs.findAll { it != null &amp;&amp; it.contains(&apos;:&apos;) }

    if (!pairs.isEmpty()) {
        def idx = new Random().nextInt(pairs.size())
        def selected = pairs[idx]

        def (routerSerial, commandId) = selected.split(&apos;:&apos;)
        vars.put(&quot;random_router_serial&quot;, routerSerial)
        vars.put(&quot;command_id&quot;, commandId)

        pairs.remove(idx)
        props.put(&quot;poll_pairs&quot;, pairs)

        log.info(&quot;Выбрана пара для ACK: router_serial=${routerSerial}, command_id=${commandId}&quot;)
    } else {
        log.warn(&quot;Нет доступных пар для ACK&quot;)
    }
}</stringProp>
        </JSR223PreProcessor>
