        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Generate Command">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.util.UUID
import groovy.json.JsonOutput

// Инициализация shared данных
def routerCommands = props.get(&quot;router_commands&quot;)
if (routerCommands == null) {
    routerCommands = new java.util.concurrent.ConcurrentHashMap()
    props.put(&quot;router_commands&quot;, routerCommands)
}

def routerCounter = props.get(&quot;router_counter&quot;) ?: 0

// Генерация команды
def routerUuid = UUID.randomUUID().toString()
routerCounter++
props.put(&quot;router_counter&quot;, routerCounter)

def body = [
    command_type: &quot;TEST_SEQUENTIAL&quot;,
    router_serial: routerUuid,
    payload: [foo: &quot;bar&quot;]
]

vars.put(&quot;requestBody&quot;, JsonOutput.toJson(body))
vars.put(&quot;current_router_serial&quot;, routerUuid)

// Сохраняем routerUuid для последующих шагов
routerCommands[routerUuid] = new java.util.concurrent.ConcurrentLinkedQueue()
log.info(&quot;Generated command for router: ${routerUuid}&quot;)</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
        </hashTree>
        <vn.zalopay.benchmark.GRPCSampler guiclass="vn.zalopay.benchmark.GRPCSamplerGui" testclass="vn.zalopay.benchmark.GRPCSampler" testname="PollCommands">
          <stringProp name="GRPCSampler.protoFolder">/Users/andrey/DEVELOP/!lesson/ourcode-iot-platform/router-manager-service/protobuf</stringProp>
          <stringProp name="GRPCSampler.host">localhost</stringProp>
