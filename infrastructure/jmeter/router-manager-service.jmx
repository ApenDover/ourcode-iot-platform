          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.util.Set
import java.util.HashSet
import java.util.List
import java.util.UUID
import java.util.Random
import groovy.json.JsonOutput

props.remove(&quot;router_serials&quot;)
Object obj = props.get(&quot;router_serials&quot;)


Set serials = new HashSet()
if (obj instanceof Set) {
    serials.addAll((Set)obj)
} else if (obj instanceof List) {
    serials.addAll((List)obj)
}

String newSerial = UUID.randomUUID().toString()
serials.add(newSerial)

props.put(&quot;router_serials&quot;, serials)

//log.info(&quot;Создан router_serial: &quot; + newSerial)
//log.info(&quot;Текущий список router_serials: &quot; + serials)

def randomSerial = &quot;fallback_serial&quot;
if (!serials.isEmpty()) {
    def idx = new Random().nextInt(serials.size())
    randomSerial = serials.toArray()[idx]
}

vars.put(&quot;random_router_serial&quot;, randomSerial)
//log.info(&quot;Выбран router_serial для потока: &quot; + randomSerial)


def body = [ commandType: &quot;TEST_LOAD&quot; ]

if (Math.random() &lt; 0.7) {
    body.routerSerial = randomSerial
}


vars.put(&quot;requestBody&quot;, JsonOutput.toJson(body))</stringProp>
          </JSR223PreProcessor>
