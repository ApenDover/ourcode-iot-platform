          <stringProp name="script">import java.util.concurrent.ConcurrentHashMap
import java.util.concurrent.ConcurrentLinkedQueue

def routerCommands = props.get(&quot;router_commands&quot;)
if (routerCommands != null) {
    routerCommands.each { routerUuid, queue -&gt;
        if (queue instanceof ConcurrentLinkedQueue) {
            queue.clear()
        }
    }
    routerCommands.clear()
}

props.remove(&quot;router_commands&quot;)
props.remove(&quot;router_counter&quot;)

log.info(&quot;TearDown: все коллекции команд и счетчики очищены&quot;)</stringProp>
