          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.util.Random

def serials = props.get(&quot;router_serials&quot;) as Set&lt;String&gt;

def randomSerial = &quot;save&quot;
//log.info(&quot;Текущий список router_serials: &quot; + serials)

if (serials &amp;&amp; !serials.isEmpty()) {
    def idx = new Random().nextInt(serials.size())
    randomSerial = serials.toArray()[idx]
}

vars.put(&quot;random_router_serial&quot;, randomSerial)

//log.info(&quot;Выбран router_serial для PollCommands: ${randomSerial}&quot;)</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper
import java.util.Collections

def response = prev.getResponseDataAsString()

if (!response || !response.trim().startsWith(&apos;{&apos;)) {
    log.warn(&quot;Ответ Poll не JSON: &apos;${response}&apos;&quot;)
    return
}

def json = new JsonSlurper().parseText(response)

synchronized(props) {
    def pairs = props.get(&quot;poll_pairs&quot;) 

    if (!(pairs instanceof List)) {
        pairs = Collections.synchronizedList([])
    }

    // Добавляем новые пары, проверяя на null
    json.commands?.each { cmd -&gt;
        if (cmd?.router_serial &amp;&amp; cmd?.id) {
            def pair = &quot;${cmd.router_serial}:${cmd.id}&quot;
            pairs.add(pair)
        } else {
            log.warn(&quot;Пропущена команда с null полями: ${cmd}&quot;)
        }
    }

    props.put(&quot;poll_pairs&quot;, pairs)
//    log.info(&quot;Сохранены пары из Poll: ${pairs}&quot;)
}</stringProp>
          </JSR223PostProcessor>
