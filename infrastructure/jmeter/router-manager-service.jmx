          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="AckCommands PreProcessor">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.util.concurrent.ConcurrentHashMap
import java.util.concurrent.ConcurrentLinkedQueue

def routerCommands = props.get(&quot;router_commands&quot;)
if (routerCommands == null) {
    log.warn(&quot;AckCommands: router_commands is null&quot;)
    routerCommands = new java.util.concurrent.ConcurrentHashMap()
    props.put(&quot;router_commands&quot;, routerCommands)
}

String routerUuid = null
String commandId = null

def foundCommand = false
def routerIter = routerCommands.entrySet().iterator()
while (routerIter.hasNext() &amp;&amp; !foundCommand) {
    def entry = routerIter.next()
    def queue = entry.value
    if (queue != null &amp;&amp; !queue.isEmpty()) {
        routerUuid = entry.key
        commandId = queue.poll() // Немедленно удаляем из очереди
        foundCommand = true
        log.info(&quot;AckCommands: взята команда ${commandId} для роутера ${routerUuid}&quot;)
    }
}

if (!foundCommand) {
    log.warn(&quot;AckCommands: нет команд для подтверждения&quot;)
    vars.put(&quot;random_router_serial&quot;, &quot;8354d1bd-ea67-494f-90fc-4b88bd874e95&quot;)
    vars.put(&quot;command_id&quot;, &quot;9354d1bd-ea67-494f-90fc-4b88bd874e95&quot;)
} else {
vars.put(&quot;random_router_serial&quot;, routerUuid)
vars.put(&quot;command_id&quot;, commandId)
}</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="AckCommands PostProcessor">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">if (vars.get(&quot;random_router_serial&quot;) == &quot;fallback-router-uuid&quot;) {
    log.warn(&quot;AckCommands: отправлен fallback-запрос&quot;)
} else {
    if (prev.isSuccessful()) {
        log.info(&quot;AckCommands: успешно отправлен ack для команды ${vars.get(&apos;command_id&apos;)}&quot;)
    } else {
        log.warn(&quot;AckCommands: неуспешный ack для команды ${vars.get(&apos;command_id&apos;)}&quot;)
    }
}</stringProp>
          </JSR223PostProcessor>
