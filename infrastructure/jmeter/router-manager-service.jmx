        <vn.zalopay.benchmark.GRPCSampler guiclass="vn.zalopay.benchmark.GRPCSamplerGui" testclass="vn.zalopay.benchmark.GRPCSampler" testname="SendCommand">
          <stringProp name="GRPCSampler.protoFolder">/Users/andrey/DEVELOP/!lesson/ourcode-iot-platform/router-manager-service/protobuf</stringProp>
          <stringProp name="GRPCSampler.host">localhost</stringProp>
          <stringProp name="GRPCSampler.port">8890</stringProp>
          <stringProp name="GRPCSampler.fullMethod">router_manager.RouterManagerService/SendCommand</stringProp>
          <stringProp name="GRPCSampler.deadline">5000</stringProp>
          <boolProp name="GRPCSampler.tls">false</boolProp>
          <stringProp name="GRPCSampler.requestJson">${requestBody}</stringProp>
          <stringProp name="GRPCSampler.libFolder"></stringProp>
          <stringProp name="GRPCSampler.metadata"></stringProp>
          <boolProp name="GRPCSampler.tlsDisableVerification">false</boolProp>
          <stringProp name="GRPCSampler.channelAwaitTermination">5000</stringProp>
          <stringProp name="GRPCSampler.maxInboundMessageSize">4194304</stringProp>
          <stringProp name="GRPCSampler.maxInboundMetadataSize">8192</stringProp>
        </vn.zalopay.benchmark.GRPCSampler>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.util.UUID
import groovy.json.JsonOutput
import java.util.concurrent.ConcurrentHashMap
import java.util.concurrent.ConcurrentLinkedQueue

int MAX_ROUTERS = 100
int MAX_QUEUE_SIZE = 100

if (!(props.get(&quot;router_commands&quot;) instanceof java.util.concurrent.ConcurrentHashMap)) {
    props.put(&quot;router_commands&quot;, new java.util.concurrent.ConcurrentHashMap())
}
if (props.get(&quot;router_counter&quot;) == null) {
    props.put(&quot;router_counter&quot;, 0)
}

def routerCommands = props.get(&quot;router_commands&quot;) as java.util.concurrent.ConcurrentHashMap
int routerCounter = props.get(&quot;router_counter&quot;) as Integer

def body = [
    command_type: &quot;TEST_LOAD&quot;,
    payload: [
        foo: &quot;bar&quot;
    ]
]

if (Math.random() &lt; 0.7) {
    // 70% - команда для конкретного роутера
    String routerUuid
    
    if (!routerCommands.isEmpty() &amp;&amp; Math.random() &lt; 0.8) {
        def existingUuids = routerCommands.keySet().toArray()
        routerUuid = existingUuids[(Math.random() * existingUuids.size()) as int] as String
    } else if (routerCounter &lt; MAX_ROUTERS) {
        routerUuid = UUID.randomUUID().toString()
        routerCounter++
        props.put(&quot;router_counter&quot;, routerCounter)
        routerCommands[routerUuid] = new java.util.concurrent.ConcurrentLinkedQueue()
    } else {
        def existingUuids = routerCommands.keySet().toArray()
        routerUuid = existingUuids[(Math.random() * existingUuids.size()) as int] as String
    }
    
    def queue = routerCommands[routerUuid] as java.util.concurrent.ConcurrentLinkedQueue
    if (queue.size() &lt; MAX_QUEUE_SIZE) {
        queue.add(&quot;pending&quot;)
    }
    
    body.router_serial = routerUuid // Для конкретного роутера
    
} else {
    // 30% - по всем роутерам команды
    body.router_serial = &quot;&quot;
    
    routerCommands.each { routerUuid, queue -&gt;
        def q = queue as java.util.concurrent.ConcurrentLinkedQueue
        if (q.size() &lt; MAX_QUEUE_SIZE) {
            q.add(&quot;pending&quot;)
        }
    }
}

vars.put(&quot;requestBody&quot;, JsonOutput.toJson(body))</stringProp>
          </JSR223PreProcessor>
