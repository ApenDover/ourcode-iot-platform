          <stringProp name="GRPCSampler.fullMethod">router_manager.RouterManagerService/PollCommands</stringProp>
          <stringProp name="GRPCSampler.deadline">5000</stringProp>
          <stringProp name="GRPCSampler.requestJson">{&quot;router_serial&quot;: &quot;${current_router_serial}&quot;}</stringProp>
          <stringProp name="GRPCSampler.libFolder"></stringProp>
          <stringProp name="GRPCSampler.metadata"></stringProp>
          <boolProp name="GRPCSampler.tls">false</boolProp>
          <boolProp name="GRPCSampler.tlsDisableVerification">false</boolProp>
          <stringProp name="GRPCSampler.channelAwaitTermination">5000</stringProp>
          <stringProp name="GRPCSampler.maxInboundMessageSize">4194304</stringProp>
          <stringProp name="GRPCSampler.maxInboundMetadataSize">8192</stringProp>
        </vn.zalopay.benchmark.GRPCSampler>
        <hashTree>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="Process Poll Response" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import groovy.json.JsonSlurper

if (prev.isSuccessful() &amp;&amp; prev.getResponseDataAsString()?.trim()?.startsWith(&apos;{&apos;)) {
    try {
        def response = new JsonSlurper().parseText(prev.getResponseDataAsString())
        def routerUuid = vars.get(&quot;current_router_serial&quot;)
        def routerCommands = props.get(&quot;router_commands&quot;)

        if (routerCommands &amp;&amp; response.commands) {
            def queue = routerCommands[routerUuid]
            if (queue == null) {
                queue = new java.util.concurrent.ConcurrentLinkedQueue()
                routerCommands[routerUuid] = queue
            }

            response.commands.each { cmd -&gt;
                if (cmd?.id) {
                    queue.add(cmd.id as String)
                    log.info(&quot;Poll: found command ${cmd.id} for router ${routerUuid}&quot;)
                }
            }
            vars.put(&quot;has_commands&quot;, queue.size() &gt; 0 ? &quot;true&quot; : &quot;false&quot;)
        }
    } catch (Exception e) {
        log.error(&quot;Poll processing error: ${e.message}&quot;)
        vars.put(&quot;has_commands&quot;, &quot;false&quot;)
    }
} else {
    vars.put(&quot;has_commands&quot;, &quot;false&quot;)
}</stringProp>
          </JSR223PostProcessor>
          <hashTree/>
        </hashTree>
        <IfController guiclass="IfControllerPanel" testclass="IfController" testname="If Commands Exist" enabled="true">
          <stringProp name="IfController.condition">${__javaScript(vars.get(&quot;has_commands&quot;) == &quot;true&quot;)}</stringProp>
          <boolProp name="IfController.evaluateAll">false</boolProp>
          <boolProp name="IfController.useExpression">false</boolProp>
        </IfController>
        <hashTree>
          <vn.zalopay.benchmark.GRPCSampler guiclass="vn.zalopay.benchmark.GRPCSamplerGui" testclass="vn.zalopay.benchmark.GRPCSampler" testname="AckCommand" enabled="true">
            <stringProp name="GRPCSampler.protoFolder">/Users/andrey/DEVELOP/!lesson/ourcode-iot-platform/router-manager-service/protobuf</stringProp>
            <stringProp name="GRPCSampler.host">localhost</stringProp>
            <stringProp name="GRPCSampler.port">8890</stringProp>
            <stringProp name="GRPCSampler.fullMethod">router_manager.RouterManagerService/AckCommand</stringProp>
            <stringProp name="GRPCSampler.deadline">5000</stringProp>
            <stringProp name="GRPCSampler.requestJson">{
  &quot;router_serial&quot;: &quot;${current_router_serial}&quot;,
  &quot;command_id&quot;: &quot;${command_id}&quot;
}</stringProp>
            <stringProp name="GRPCSampler.libFolder"></stringProp>
            <stringProp name="GRPCSampler.metadata"></stringProp>
            <boolProp name="GRPCSampler.tls">false</boolProp>
            <boolProp name="GRPCSampler.tlsDisableVerification">false</boolProp>
            <stringProp name="GRPCSampler.channelAwaitTermination">5000</stringProp>
            <stringProp name="GRPCSampler.maxInboundMessageSize">4194304</stringProp>
            <stringProp name="GRPCSampler.maxInboundMetadataSize">8192</stringProp>
          </vn.zalopay.benchmark.GRPCSampler>
          <hashTree>
            <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="Get Command for Ack" enabled="true">
              <stringProp name="scriptLanguage">groovy</stringProp>
              <stringProp name="parameters"></stringProp>
              <stringProp name="filename"></stringProp>
              <stringProp name="cacheKey">true</stringProp>
              <stringProp name="script">def routerUuid = vars.get(&quot;current_router_serial&quot;)
def routerCommands = props.get(&quot;router_commands&quot;)

if (routerCommands) {
    def queue = routerCommands[routerUuid]
    if (queue &amp;&amp; !queue.isEmpty()) {
        def commandId = queue.poll()
        vars.put(&quot;command_id&quot;, commandId)
        log.info(&quot;Ack: processing command ${commandId} for router ${routerUuid}&quot;)
    } else {
        vars.put(&quot;command_id&quot;, &quot;no-command-available&quot;)
    }
}</stringProp>
            </JSR223PreProcessor>
            <hashTree/>
          </hashTree>
        </hashTree>
