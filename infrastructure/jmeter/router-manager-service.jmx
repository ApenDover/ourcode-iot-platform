        <vn.zalopay.benchmark.GRPCSampler guiclass="vn.zalopay.benchmark.GRPCSamplerGui" testclass="vn.zalopay.benchmark.GRPCSampler" testname="AckCommands" enabled="true">
          <stringProp name="GRPCSampler.protoFolder">/Users/andrey/DEVELOP/!lesson/ourcode-iot-platform/router-manager-service/protobuf</stringProp>
          <stringProp name="GRPCSampler.host">localhost</stringProp>
          <stringProp name="GRPCSampler.port">8890</stringProp>
          <stringProp name="GRPCSampler.fullMethod">router_manager.RouterManagerService/AckCommand</stringProp>
          <stringProp name="GRPCSampler.deadline">5000</stringProp>
          <stringProp name="GRPCSampler.requestJson">{
  &quot;router_serial&quot;: &quot;${random_router_serial}&quot;,
  &quot;command_id&quot;: &quot;${command_id}&quot;
}</stringProp>
          <stringProp name="GRPCSampler.libFolder"></stringProp>
          <stringProp name="GRPCSampler.metadata"></stringProp>
          <boolProp name="GRPCSampler.tls">false</boolProp>
          <boolProp name="GRPCSampler.tlsDisableVerification">false</boolProp>
          <stringProp name="GRPCSampler.channelAwaitTermination">5000</stringProp>
          <stringProp name="GRPCSampler.maxInboundMessageSize">4194304</stringProp>
          <stringProp name="GRPCSampler.maxInboundMetadataSize">8192</stringProp>
        </vn.zalopay.benchmark.GRPCSampler>
        <hashTree>
          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="JSR223 PreProcessor">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.util.concurrent.ConcurrentHashMap

if (!(props.get(&quot;acknowledged_commands&quot;) instanceof java.util.concurrent.ConcurrentHashMap)) {
    props.put(&quot;acknowledged_commands&quot;, new java.util.concurrent.ConcurrentHashMap())
}
def ackCommands = props.get(&quot;acknowledged_commands&quot;) as java.util.concurrent.ConcurrentHashMap

String routerUuid = null
String commandId = null

// Ищем команду для подтверждения (только со статусом true)
def commandToAck = ackCommands.find { commandKey, status -&gt; 
    status == true
}

if (commandToAck) {
    def commandKey = commandToAck.key as String
    if (commandKey &amp;&amp; commandKey.contains(&quot;:&quot;)) {
        def parts = commandKey.split(&quot;:&quot;)
        if (parts.length == 2) {
            routerUuid = parts[0]
            commandId = parts[1]
            // Помечаем как &quot;в процессе&quot;, чтобы другие потоки не брали эту же команду
            ackCommands[commandKey] = &quot;in_progress&quot;
        }
    }
}

// Fallback только если совсем нет команд
if (!routerUuid || !commandId) {
    routerUuid = &quot;8354d1bd-ea67-494f-90fc-4b88bd874e95&quot;
    commandId = &quot;9354d1bd-ea67-494f-90fc-4b88bd874e95&quot;
    log.warn(&quot;AckCommands: нет команд для подтверждения, использую fallback&quot;)
}

vars.put(&quot;random_router_serial&quot;, routerUuid)
vars.put(&quot;command_id&quot;, commandId)
vars.put(&quot;ack_command_key&quot;, &quot;${routerUuid}:${commandId}&quot;)</stringProp>
          </JSR223PreProcessor>
          <hashTree/>
          <JSR223PostProcessor guiclass="TestBeanGUI" testclass="JSR223PostProcessor" testname="JSR223 PostProcessor">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.util.concurrent.ConcurrentHashMap

def commandKey = vars.get(&quot;ack_command_key&quot;)

if (commandKey &amp;&amp; commandKey != &quot;8354d1bd-ea67-494f-90fc-4b88bd874e95:9354d1bd-ea67-494f-90fc-4b88bd874e95&quot;) {
    
    if (commandKey.contains(&quot;:&quot;)) {
        def ackCommands = props.get(&quot;acknowledged_commands&quot;) as java.util.concurrent.ConcurrentHashMap ?: new java.util.concurrent.ConcurrentHashMap()
        if (prev.isSuccessful()) {
            ackCommands.remove(commandKey)
        } else {
            ackCommands[commandKey] = true
        }
    }
}

vars.remove(&quot;ack_command_key&quot;)</stringProp>
          </JSR223PostProcessor>
