          <JSR223PreProcessor guiclass="TestBeanGUI" testclass="JSR223PreProcessor" testname="SendCommand PreProcessor" enabled="true">
            <stringProp name="scriptLanguage">groovy</stringProp>
            <stringProp name="parameters"></stringProp>
            <stringProp name="filename"></stringProp>
            <stringProp name="cacheKey">true</stringProp>
            <stringProp name="script">import java.util.UUID
import groovy.json.JsonOutput
import java.util.concurrent.ConcurrentHashMap
import java.util.concurrent.ConcurrentLinkedQueue

int MAX_ROUTERS = 100

def routerCommands = props.get(&quot;router_commands&quot;)
if (routerCommands == null) {
    routerCommands = new java.util.concurrent.ConcurrentHashMap()
    props.put(&quot;router_commands&quot;, routerCommands)
}

def routerCounter = props.get(&quot;router_counter&quot;)
if (routerCounter == null) {
    routerCounter = 0
    props.put(&quot;router_counter&quot;, routerCounter)
}

def body = [
    command_type: &quot;TEST_LOAD&quot;,
    payload: [
        foo: &quot;bar&quot;
    ]
]

// 70% - команда для конкретного роутера, 30% - broadcast
if (Math.random() &lt; 0.9) {
    String routerUuid
    // Выбор существующего или создание нового роутера
    if (!routerCommands.isEmpty() &amp;&amp; Math.random() &lt; 0.8 &amp;&amp; routerCounter &gt;= MAX_ROUTERS) {
        def existingUuids = routerCommands.keySet().toArray()
        routerUuid = existingUuids[(Math.random() * existingUuids.size()) as int] as String
    } else if (routerCounter &lt; MAX_ROUTERS) {
        routerUuid = UUID.randomUUID().toString()
        routerCounter++
        props.put(&quot;router_counter&quot;, routerCounter)
        routerCommands[routerUuid] = new java.util.concurrent.ConcurrentLinkedQueue()
    } else {
        def existingUuids = routerCommands.keySet().toArray()
        routerUuid = existingUuids[(Math.random() * existingUuids.size()) as int] as String
    }
    
    body.router_serial = routerUuid
    
} else {
    body.router_serial = &quot;&quot;
}

vars.put(&quot;requestBody&quot;, JsonOutput.toJson(body))</stringProp>
          </JSR223PreProcessor>
